# Copia este archivo como .env y rellénalo. Nunca subas .env al repositorio.

# Tu zona horaria (las horas de los mensajes salen en ella)
TZ_USUARIA=Europe/Madrid

# Claude (redacta los mensajes y valora las noticias). Sin clave, la oficina usa plantillas.
ANTHROPIC_API_KEY=
# MODELO_REDACTOR=claude-sonnet-5-5
# MODELO_FILTRO=claude-haiku-5-5

# Equipos activos (plantillas en src/equipo/definiciones.ts)
EQUIPOS=nasdaq

# Telegram (gratis). Si está configurado, tiene prioridad sobre WhatsApp.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta). Sin Telegram ni WhatsApp, los mensajes salen por consola.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DESTINO=          # tu número, p. ej. 34600111222
WHATSAPP_VERIFY_TOKEN=     # una palabra secreta que inventas para el webhook
WHATSAPP_APP_SECRET=       # para comprobar que los mensajes vienen de Meta
WHATSAPP_PLANTILLA=aviso_oficina
WHATSAPP_PLANTILLA_IDIOMA=es

# Factor Macro (tu app de macro)
FACTOR_MACRO_URL=https://factormacro.santostrader.com
FACTOR_MACRO_CLAVE=        # clave de equipo, para leer el briefing semanal de Nova

# Factor Métricas (tu app de métricas). Con esto, el gestor de cuentas lee tus
# cuentas activas, sus reglas y tus operaciones de ahí, solo lectura.
# URL y clave pública: las mismas VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY de la app.
FACTOR_METRICAS_URL=
FACTOR_METRICAS_ANON_KEY=
FACTOR_METRICAS_EMAIL=
FACTOR_METRICAS_PASSWORD=

# Otros
# MAX_AVISOS_HORA=4
# DRY_RUN=1
# PORT=3000
