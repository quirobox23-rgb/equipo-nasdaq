# Copia este archivo a .env.local y rellena con los datos de tu proyecto
# de Supabase (Project Settings → API). Nunca subas .env.local a git
# (ya está en .gitignore por convención de Vite, verifícalo).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Agente Métricas usa un proyecto de Supabase PROPIO (no el de Factor Métricas).
# Crea uno nuevo y carga supabase/schema.sql en el editor SQL.
VITE_ADMIN_EMAILS=          # emails del equipo, separados por comas
VITE_SITE_URL=              # dirección pública de la app (para los emails de acceso)
VITE_COMUNIDAD_URL=         # enlace a tu comunidad (opcional)
